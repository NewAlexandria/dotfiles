#!/usr/bin/env bash
# vidreel — join images and videos into one MP4, in the order given.
#
# Each image must be followed by the number of seconds it should be shown.
# Videos are used as-is. Everything is scaled (letterboxed) to one size and
# frame rate. Audio from videos is kept if EVERY video has an audio track;
# otherwise the output is silent.
#
# Usage: vidreel [-o out.mp4] [-s WxH] [-r fps] [-q crf] FILE [SECS] FILE [SECS] ...
# Example: vidreel -o reel.mp4 title.jpg 3 a.mp4 b.mp4 c.mp4
set -euo pipefail

out="vidreel_out.mp4"; size=""; fps=30; crf=18
usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }

while getopts "o:s:r:q:h" opt; do
  case $opt in
    o) out=$OPTARG ;; s) size=$OPTARG ;; r) fps=$OPTARG ;; q) crf=$OPTARG ;;
    h) usage 0 ;; *) usage 1 ;;
  esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage 1
command -v ffmpeg >/dev/null || { echo "vidreel: ffmpeg not found" >&2; exit 1; }

is_image() { case "$(printf %s "$1" | tr '[:upper:]' '[:lower:]')" in
  *.jpg|*.jpeg|*.png|*.webp|*.bmp|*.tif|*.tiff|*.heic|*.gif) return 0 ;; *) return 1 ;; esac; }
has_audio() { [ -n "$(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 "$1")" ]; }

files=(); durs=()
while [ $# -gt 0 ]; do
  f=$1; shift
  [ -f "$f" ] || { echo "vidreel: no such file: $f" >&2; exit 1; }
  if is_image "$f"; then
    [[ ${1:-} =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "vidreel: image '$f' must be followed by seconds" >&2; exit 1; }
    files+=("$f"); durs+=("$1"); shift
  else
    files+=("$f"); durs+=("")
  fi
done

# Default size: the largest video's dimensions, else the first image's.
if [ -z "$size" ]; then
  best=0
  for i in "${!files[@]}"; do
    [ -z "${durs[$i]}" ] || continue
    wh=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "${files[$i]}")
    px=$(( ${wh%x*} * ${wh#*x} ))
    [ "$px" -gt "$best" ] && { best=$px; size=$wh; }
  done
  [ -n "$size" ] || size=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "${files[0]}")
fi
W=${size%x*}; H=${size#*x}

audio=1
for i in "${!files[@]}"; do
  [ -z "${durs[$i]}" ] && { has_audio "${files[$i]}" || audio=0; }
done

inputs=(); filt=""; concat=""
for i in "${!files[@]}"; do
  if [ -n "${durs[$i]}" ]; then
    inputs+=(-loop 1 -t "${durs[$i]}" -framerate "$fps" -i "${files[$i]}")
  else
    inputs+=(-i "${files[$i]}")
  fi
  filt+="[$i:v]scale=$W:$H:force_original_aspect_ratio=decrease,pad=$W:$H:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=$fps,format=yuv420p[v$i];"
  if [ "$audio" = 1 ]; then
    if [ -n "${durs[$i]}" ]; then
      filt+="anullsrc=r=44100:cl=stereo,atrim=0:${durs[$i]}[a$i];"
    else
      filt+="[$i:a]aresample=44100,aformat=channel_layouts=stereo[a$i];"
    fi
    concat+="[v$i][a$i]"
  else
    concat+="[v$i]"
  fi
done

n=${#files[@]}
if [ "$audio" = 1 ]; then
  filt+="${concat}concat=n=$n:v=1:a=1[v][a]"; maps=(-map "[v]" -map "[a]" -c:a aac)
else
  filt+="${concat}concat=n=$n:v=1:a=0[v]"; maps=(-map "[v]")
fi

echo "vidreel: $n inputs -> $out (${W}x${H} @ ${fps}fps, audio=$([ $audio = 1 ] && echo yes || echo no))" >&2
ffmpeg -hide_banner -loglevel error -stats -y "${inputs[@]}" -filter_complex "$filt" \
  "${maps[@]}" -c:v libx264 -crf "$crf" -preset medium -movflags +faststart "$out"
echo "vidreel: wrote $out" >&2
